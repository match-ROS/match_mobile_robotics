<?xml version="1.0"?>
<package format="2">
  <name>scene_builder</name>
  <version>1.0.0</version>
  <description>
    Dynamic collision scene management for MoveIt.
    Provides tools to add, remove, and animate collision objects in the planning scene,
    with support for waypoint-based motion sequences and velocity commands.
  </description>

  <maintainer email="simone@todo.todo">simone</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>moveit_commander</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <export>
  </export>
</package>
